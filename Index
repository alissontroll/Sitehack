<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RAMOS AI — Inteligência em Segurança Digital</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Share+Tech+Mono&family=Inter:wght@300;400;500&display=swap');

:root {
  --bg:       #07080d;
  --bg2:      #0b0d15;
  --bg3:      #0f1120;
  --blue:     #3d6bff;
  --blue-b:   #6287ff;
  --cyan:     #00d4ff;
  --silver:   #a8b4cc;
  --white:    #f0f4ff;
  --dim:      #4a5470;
  --border:   rgba(61,107,255,0.18);
  --border2:  rgba(255,255,255,0.06);
}

*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; }

body {
  background: var(--bg);
  color: var(--silver);
  font-family: 'Inter', sans-serif;
  overflow-x: hidden;
}

/* ── CANVAS BACKGROUND ── */
#bg-canvas {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
}

/* ── NAV ── */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.2rem 4rem;
  background: rgba(7,8,13,0.75);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border2);
  transition: background 0.3s;
}

.nav-logo {
  font-family: 'Syne', sans-serif;
  font-weight: 800;
  font-size: 1.25rem;
  color: var(--white);
  letter-spacing: 0.08em;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.logo-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--blue);
  box-shadow: 0 0 12px var(--blue);
  animation: pulse-dot 2s ease-in-out infinite;
}

@keyframes pulse-dot {
  0%,100% { transform: scale(1); box-shadow: 0 0 12px var(--blue); }
  50%      { transform: scale(1.4); box-shadow: 0 0 24px var(--cyan); }
}

.nav-links {
  display: flex; gap: 2.5rem; list-style: none;
}

.nav-links a {
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.72rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--dim);
  text-decoration: none;
  transition: color 0.2s;
  position: relative;
}

.nav-links a::after {
  content: '';
  position: absolute;
  bottom: -4px; left: 0;
  width: 0; height: 1px;
  background: var(--blue);
  transition: width 0.25s;
}

.nav-links a:hover { color: var(--white); }
.nav-links a:hover::after { width: 100%; }

.nav-cta {
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--white);
  background: var(--blue);
  border: none;
  padding: 0.6rem 1.4rem;
  cursor: pointer;
  transition: all 0.25s;
  text-decoration: none;
}

.nav-cta:hover {
  background: var(--blue-b);
  box-shadow: 0 0 24px rgba(61,107,255,0.5);
  transform: translateY(-1px);
}

/* ── HERO ── */
#hero {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding: 0 4rem;
  max-width: 1200px;
  margin: 0 auto;
}

.hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
  width: 100%;
  padding-top: 5rem;
}

.hero-left { position: relative; }

.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.68rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--blue-b);
  border: 1px solid var(--border);
  padding: 0.4rem 1rem;
  margin-bottom: 2rem;
  background: rgba(61,107,255,0.06);
  opacity: 0;
  animation: fadeUp 0.8s 0.2s forwards;
}

.tag-icon { font-size: 0.8rem; animation: spin 6s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.hero-title {
  font-family: 'Syne', sans-serif;
  font-size: clamp(2.8rem, 5.5vw, 5rem);
  font-weight: 800;
  color: var(--white);
  line-height: 1.0;
  letter-spacing: -0.03em;
  margin-bottom: 1.5rem;
  opacity: 0;
  animation: fadeUp 0.8s 0.35s forwards;
}

.hero-title .line2 {
  background: linear-gradient(135deg, var(--blue) 0%, var(--cyan) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-desc {
  font-size: 0.95rem;
  color: var(--silver);
  line-height: 1.85;
  font-weight: 300;
  max-width: 460px;
  margin-bottom: 2.5rem;
  opacity: 0;
  animation: fadeUp 0.8s 0.5s forwards;
}

.hero-actions {
  display: flex;
  gap: 1rem;
  align-items: center;
  opacity: 0;
  animation: fadeUp 0.8s 0.65s forwards;
}

.btn-blue {
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--white);
  background: linear-gradient(135deg, var(--blue), #2952d9);
  border: none;
  padding: 1rem 2.2rem;
  cursor: pointer;
  text-decoration: none;
  display: inline-block;
  transition: all 0.25s;
  position: relative;
  overflow: hidden;
}

.btn-blue::after {
  content: '';
  position: absolute;
  top: -50%; left: -60%;
  width: 50%; height: 200%;
  background: rgba(255,255,255,0.12);
  transform: skewX(-20deg);
  transition: left 0.4s;
}

.btn-blue:hover::after { left: 150%; }
.btn-blue:hover { box-shadow: 0 0 30px rgba(61,107,255,0.55); transform: translateY(-2px); }

.btn-ghost {
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--silver);
  background: transparent;
  border: 1px solid var(--border2);
  padding: 1rem 2.2rem;
  cursor: pointer;
  text-decoration: none;
  display: inline-block;
  transition: all 0.25s;
}

.btn-ghost:hover { border-color: var(--border); color: var(--white); background: rgba(61,107,255,0.05); }

@keyframes fadeUp {
  from { opacity:0; transform: translateY(20px); }
  to   { opacity:1; transform: translateY(0); }
}

/* HERO VISUAL — HUD */
.hero-right {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  opacity: 0;
  animation: fadeUp 1s 0.5s forwards;
}

.hud-wrap {
  position: relative;
  width: 420px;
  height: 420px;
}

.hud-ring {
  position: absolute;
  border-radius: 50%;
  border: 1px solid;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
}

.ring1 { width: 380px; height: 380px; border-color: rgba(61,107,255,0.15); animation: rotate 25s linear infinite; }
.ring2 { width: 300px; height: 300px; border-color: rgba(0,212,255,0.12); animation: rotate 15s linear infinite reverse; }
.ring3 { width: 220px; height: 220px; border-color: rgba(61,107,255,0.2); animation: rotate 10s linear infinite; }

.ring1::before { content:''; position:absolute; top:-3px; left:50%; width:6px; height:6px; border-radius:50%; background:var(--blue); box-shadow:0 0 10px var(--blue); transform:translateX(-50%); }
.ring2::after  { content:''; position:absolute; bottom:-3px; right:30px; width:5px; height:5px; border-radius:50%; background:var(--cyan); box-shadow:0 0 8px var(--cyan); }
.ring3::before { content:''; position:absolute; top:20px; right:-3px; width:4px; height:4px; border-radius:50%; background:var(--blue-b); box-shadow:0 0 8px var(--blue-b); }

@keyframes rotate { to { transform: translate(-50%,-50%) rotate(360deg); } }

.hud-center {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 140px; height: 140px;
  background: radial-gradient(circle, rgba(61,107,255,0.18) 0%, rgba(7,8,13,0.9) 70%);
  border: 1px solid rgba(61,107,255,0.35);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.3rem;
}

.hud-num {
  font-family: 'Syne', sans-serif;
  font-size: 2.2rem;
  font-weight: 800;
  color: var(--white);
  line-height: 1;
}

.hud-label {
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.55rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--blue-b);
}

.hud-node {
  position: absolute;
  background: rgba(11,13,21,0.95);
  border: 1px solid var(--border);
  padding: 0.7rem 1rem;
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.62rem;
  color: var(--silver);
  white-space: nowrap;
  animation: float 4s ease-in-out infinite;
}

.hud-node .val { color: var(--cyan); font-size: 0.85rem; display: block; margin-bottom: 0.1rem; }
.hud-node.n1 { top: 20px; right: -20px; animation-delay: 0s; }
.hud-node.n2 { bottom: 40px; left: -30px; animation-delay: 1.5s; }
.hud-node.n3 { top: 110px; left: -50px; animation-delay: 0.8s; }

@keyframes float {
  0%,100% { transform: translateY(0); }
  50%      { transform: translateY(-6px); }
}

/* ── TICKER ── */
.ticker-wrap {
  position: relative;
  z-index: 1;
  background: rgba(61,107,255,0.06);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  padding: 0.8rem 0;
  overflow: hidden;
}

.ticker-track {
  display: flex;
  gap: 4rem;
  animation: ticker 22s linear infinite;
  white-space: nowrap;
}

.ticker-track:hover { animation-play-state: paused; }

.ticker-item {
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.7rem;
  letter-spacing: 0.15em;
  color: var(--dim);
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

.ticker-item .dot { color: var(--blue); }
.ticker-item .active { color: var(--cyan); }

@keyframes ticker { from { transform: translateX(0); } to { transform: translateX(-50%); } }

/* ── STATS ── */
.stats-section {
  position: relative;
  z-index: 1;
  max-width: 1200px;
  margin: 0 auto;
  padding: 6rem 4rem;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2px;
}

.stat-block {
  padding: 2.5rem 2rem;
  background: var(--bg2);
  border: 1px solid var(--border2);
  position: relative;
  overflow: hidden;
  transition: all 0.3s;
}

.stat-block::before {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--blue), var(--cyan));
  transform: scaleX(0);
  transition: transform 0.4s;
}

.stat-block:hover::before { transform: scaleX(1); }
.stat-block:hover { background: rgba(61,107,255,0.04); }

.stat-n {
  font-family: 'Syne', sans-serif;
  font-size: 3rem;
  font-weight: 800;
  color: var(--white);
  line-height: 1;
  margin-bottom: 0.5rem;
  display: block;
}

.stat-n .suf { font-size: 1.5rem; color: var(--blue); }

.stat-lbl {
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--dim);
}

/* ── SECTION COMMON ── */
.sec {
  position: relative;
  z-index: 1;
  max-width: 1200px;
  margin: 0 auto;
  padding: 7rem 4rem;
}

.eyebrow {
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.68rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--blue-b);
  margin-bottom: 1rem;
  display: flex;
  align-items: center;
  gap: 0.8rem;
}

.eyebrow::before {
  content: '';
  width: 24px; height: 1px;
  background: var(--blue);
  box-shadow: 0 0 6px var(--blue);
}

.sec-title {
  font-family: 'Syne', sans-serif;
  font-size: clamp(1.8rem, 3.5vw, 3rem);
  font-weight: 800;
  color: var(--white);
  line-height: 1.1;
  letter-spacing: -0.02em;
  margin-bottom: 3.5rem;
}

/* ── SERVICES ── */
.svc-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5px;
}

.svc-card {
  background: var(--bg2);
  border: 1px solid var(--border2);
  padding: 2.5rem;
  position: relative;
  overflow: hidden;
  transition: all 0.35s;
  cursor: default;
}

.svc-card::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(61,107,255,0.07) 0%, transparent 60%);
  opacity: 0;
  transition: opacity 0.35s;
}

.svc-card:hover { transform: translateY(-4px); border-color: var(--border); background: var(--bg3); }
.svc-card:hover::after { opacity: 1; }

.svc-num {
  font-family: 'Syne', sans-serif;
  font-size: 3.5rem;
  font-weight: 800;
  color: rgba(61,107,255,0.08);
  line-height: 1;
  margin-bottom: 1.5rem;
  display: block;
  transition: color 0.3s;
}

.svc-card:hover .svc-num { color: rgba(61,107,255,0.18); }

.svc-icon {
  width: 44px; height: 44px;
  background: rgba(61,107,255,0.1);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  margin-bottom: 1.2rem;
  transition: all 0.3s;
}

.svc-card:hover .svc-icon {
  background: rgba(61,107,255,0.2);
  box-shadow: 0 0 20px rgba(61,107,255,0.2);
}

.svc-name {
  font-family: 'Syne', sans-serif;
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--white);
  margin-bottom: 0.8rem;
  letter-spacing: -0.01em;
}

.svc-desc {
  font-size: 0.82rem;
  color: var(--silver);
  line-height: 1.75;
  font-weight: 300;
}

/* ── ABOUT ── */
.about-grid {
  display: grid;
  grid-template-columns: 5fr 7fr;
  gap: 6rem;
  align-items: start;
}

.founder-card {
  background: var(--bg2);
  border: 1px solid var(--border2);
  overflow: hidden;
  position: sticky;
  top: 6rem;
}

.founder-img {
  width: 100%;
  aspect-ratio: 4/5;
  background: var(--bg3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 7rem;
  position: relative;
  overflow: hidden;
}

.founder-img::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 50%, var(--bg2) 100%);
}

.founder-scan {
  position: absolute;
  left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--blue), transparent);
  box-shadow: 0 0 15px var(--blue);
  animation: scan 4s ease-in-out infinite;
}

@keyframes scan {
  0% { top: 0; opacity: 0; }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% { top: 100%; opacity: 0; }
}

.founder-info {
  padding: 1.5rem;
  position: relative;
  z-index: 1;
}

.founder-name {
  font-family: 'Syne', sans-serif;
  font-size: 1.2rem;
  font-weight: 800;
  color: var(--white);
  margin-bottom: 0.2rem;
}

.founder-role {
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--blue-b);
  margin-bottom: 1rem;
}

.founder-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.ftag {
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.6rem;
  letter-spacing: 0.1em;
  color: var(--dim);
  border: 1px solid rgba(255,255,255,0.05);
  padding: 0.25rem 0.6rem;
  text-transform: uppercase;
  background: rgba(255,255,255,0.02);
}

.about-content p {
  font-size: 0.92rem;
  color: var(--silver);
  line-height: 1.85;
  font-weight: 300;
  margin-bottom: 1.2rem;
}

.timeline {
  margin-top: 3rem;
  border-left: 1px solid var(--border);
  padding-left: 2rem;
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.tl-item { position: relative; }

.tl-item::before {
  content: '';
  position: absolute;
  left: -2.45rem;
  top: 0.35rem;
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--blue);
  box-shadow: 0 0 10px var(--blue);
}

.tl-year {
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  color: var(--blue-b);
  text-transform: uppercase;
  margin-bottom: 0.3rem;
}

.tl-text {
  font-family: 'Syne', sans-serif;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--white);
  margin-bottom: 0.3rem;
}

.tl-sub {
  font-size: 0.8rem;
  color: var(--dim);
  font-weight: 300;
}

/* ── MISSION BANNER ── */
.mission-band {
  position: relative;
  z-index: 1;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(61,107,255,0.12) 0%, rgba(0,212,255,0.05) 100%);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  padding: 5rem 4rem;
  text-align: center;
}

.mission-band::before {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    -45deg,
    transparent,
    transparent 40px,
    rgba(61,107,255,0.02) 40px,
    rgba(61,107,255,0.02) 41px
  );
}

.mission-quote {
  font-family: 'Syne', sans-serif;
  font-size: clamp(1.2rem, 2.5vw, 2rem);
  font-weight: 700;
  color: var(--white);
  line-height: 1.5;
  max-width: 800px;
  margin: 0 auto 1.5rem;
  position: relative;
  z-index: 1;
}

.mission-quote em {
  font-style: normal;
  background: linear-gradient(90deg, var(--blue), var(--cyan));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.mission-sig {
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.7rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--dim);
  position: relative;
  z-index: 1;
}

/* ── CONTACT ── */
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 5rem;
}

.contact-meta p {
  font-size: 0.88rem;
  color: var(--silver);
  line-height: 1.8;
  font-weight: 300;
  margin-bottom: 2.5rem;
}

.cinfo-row {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  padding: 1.2rem 0;
  border-bottom: 1px solid var(--border2);
}

.ci-icon {
  width: 36px; height: 36px;
  background: rgba(61,107,255,0.1);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.9rem;
  flex-shrink: 0;
}

.ci-lbl {
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--dim);
  margin-bottom: 0.25rem;
}

.ci-val {
  font-size: 0.85rem;
  color: var(--white);
}

.form-wrap {
  background: var(--bg2);
  border: 1px solid var(--border2);
  padding: 2.5rem;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  margin-bottom: 1rem;
}

.fg {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  margin-bottom: 1rem;
}

.flabel {
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.62rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--dim);
}

.finput, .ftarea {
  background: var(--bg3);
  border: 1px solid var(--border2);
  color: var(--white);
  font-family: 'Inter', sans-serif;
  font-size: 0.82rem;
  font-weight: 300;
  padding: 0.85rem 1rem;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.finput:focus, .ftarea:focus {
  border-color: var(--blue);
  box-shadow: 0 0 0 2px rgba(61,107,255,0.12);
}

.ftarea { min-height: 100px; resize: vertical; }

/* ── FOOTER ── */
footer {
  position: relative;
  z-index: 1;
  border-top: 1px solid var(--border2);
  padding: 2.5rem 4rem;
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.foot-logo {
  font-family: 'Syne', sans-serif;
  font-weight: 800;
  font-size: 1rem;
  color: var(--white);
